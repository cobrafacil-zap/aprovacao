# ============================================================
# Oferta Fit BR — variáveis de ambiente
# (na Vercel: Project → Settings → Environment Variables)
# ============================================================

# --- Admin (painel /admin.html) ---
ADMIN_SENHA=Comsoc1#

# --- Banco de dados: Upstash Redis (obrigatório na Vercel) ---
# Crie em: Vercel → Storage → Marketplace → "Upstash for Redis" (plano grátis)
# As duas variáveis abaixo são preenchidas automaticamente pela integração.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Fotos das receitas: Vercel Blob (obrigatório na Vercel) ---
# Crie em: Vercel → Storage → Blob (plano grátis)
BLOB_READ_WRITE_TOKEN=

# --- E-mail: Resend (obrigatório na Vercel) ---
# Crie em: https://resend.com → API Keys
# Atenção: valide o domínio do remetente (ex.: entrega@seudominio.com)
RESEND_API_KEY=
FROM_EMAIL=entrega@ofertafitbr.com

# --- Vercel Cron (protege a rota /api/cron) ---
# A Vercel envia automaticamente este valor como Bearer token nas chamadas do cron.
CRON_SECRET=

# --- URL pública (usada nos links dos e-mails) ---
PUBLIC_BASE_URL=https://aprovacao-psi.vercel.app

# --- Pagamento (produção) — Mercado Pago ---
# Sem isso, o checkout roda em MODO DEMO (simula aprovação).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Apenas desenvolvimento local (SMTP como alternativa ao Resend) ---
# SMTP_HOST=smtp.seuprovedor.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
