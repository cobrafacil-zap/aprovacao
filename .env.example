# --- Servidor ---
PORT=3000

# --- Admin (painel /admin.html) ---
ADMIN_SENHA=Comsoc1#

# --- E-mail (opcional: sem isso o envio fica em modo "simulado" no console) ---
# Opção A — SMTP
SMTP_HOST=smtp.seuprovedor.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=entrega@ofertafitbr.com
# Opção B — Resend (se RESEND_API_KEY existir, ela tem prioridade)
RESEND_API_KEY=

# --- Pagamento (produção) ---
# Mercado Pago: preencha para criar cobrança Pix/cartão/boleto reais.
# Sem isso, o checkout roda em MODO DEMO (simula aprovação).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000
