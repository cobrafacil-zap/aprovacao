---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE, PILLARS, TIMELINE } from '../site.config.js';
---

<Layout
  title={`${SITE.name} — ${SITE.slogan}`}
  description={SITE.shortBio}
  pageType="profile"
>
  <!-- ====== HERO assimétrico: foto à direita, texto à esquerda ====== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__container container">
      <div class="hero__copy">
        <p class="hero__eyebrow">
          Eleições 2026 · {SITE.party} · {SITE.state} · Deputada Estadual
        </p>
        <h1 id="hero-title" class="hero__title">
          Eu sou a neta da Francisca. <span class="hero__title-strike">Agora é a vez</span> das <span class="hero__title-mark">nossas comunidades</span> na Assembleia.
        </h1>
        <p class="hero__tagline">
          Assistente social. Norte pioneiro do Paraná. Mãe da APAE de Jundiaí do Sul.
          Tô na campanha pra levar a força de quem cuida, de quem produz, de quem
          ainda não foi ouvida pra <strong>onde se escreve lei.</strong>
        </p>

        <div class="hero__actions">
          <Button href="/propostas/" variant="primary" size="lg">
            {SITE.home.ctaPrimary}
          </Button>
          <Button
            href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Olá Elisângela, vim pelo site e quero conversar.')}`}
            variant="secondary"
            size="lg"
            external
          >
            {SITE.home.ctaSecondary}
          </Button>
        </div>

        <ul class="hero__badges" aria-label="Identidade da campanha">
          <li>Norte Pioneiro</li>
          <li>Assistente Social</li>
          <li>APAE Jundiaí do Sul</li>
          <li>Mulher do Interior</li>
        </ul>
      </div>

      <div class="hero__visual">
        <figure class="hero__portrait">
          <img
            src="/images/hero-chamado-original.jpg"
            alt="Elisângela Tomba, de blazer vermelho, com a mão estendida em direção ao espectador, sorrindo — chamando a pessoa à frente dela pra essa campanha."
            width="1200"
            height="1800"
            fetchpriority="high"
          />
          <figcaption class="hero__caption">
            <span>Jundiaí do Sul · 2024</span>
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ====== FAIXA DIAGONAL — efeito de rua ====== -->
  <aside class="street-banner" aria-hidden="true">
    <div class="street-banner__track">
      <span>AGORA É A VEZ DAS COMUNIDADES NA ASSEMBLEIA</span>
      <span>★</span>
      <span>NETA DA FRANCISCA · FILHA DA ROÇA · ASSISTENTE SOCIAL</span>
      <span>★</span>
      <span>AGENDA CHEIA EM JUNDIAÍ DO SUL · CAFÉ E ALGODÃO</span>
      <span>★</span>
      <span>AGENDA CHEIA EM JAGUAPITÃ · NORTE PIONEIRO</span>
      <span>★</span>
    </div>
  </aside>

  <!-- ====== QUEM É A ELISÂNGELA (bio em primeira pessoa, assimétrico) ====== -->
  <section class="bio" aria-labelledby="bio-title">
    <div class="bio__container container">
      <div class="bio__text">
        <p class="bio__eyebrow">Quem é</p>
        <h2 id="bio-title" class="bio__title">Eu vim da roça. Voltei pra ficar.</h2>

        <p class="bio__lead">
          Nasci em Jundiaí do Sul, norte pioneiro do Paraná. Cresci colhendo café
          e algodão do lado da <strong>vó Francisca</strong>, mulher que criou 8 filhos
          sozinha e me ensinou cedo que trabalho e dignidade andam juntos.
        </p>

        <p>
          Virei <strong>assistente social</strong> pra defender quem não tinha voz.
          Em <strong>1996</strong>, juntei famílias, voluntários, padaria e prefeitura
          pra abrir a primeira sala da <strong>APAE de Jundiaí do Sul</strong> — com
          fono, fisio e psicopedagoga. Hoje a APAE atende centenas de famílias.
        </p>

        <p>
          Em <strong>2026</strong> decidi levar essa história pra Assembleia Legislativa
          do Paraná. Não pra fazer discurso bonito — pra <strong>escrever lei</strong>
          com quem viveu o problema.
        </p>

        <Button href="/sobre/" variant="secondary" size="md">
          Ler a história completa
        </Button>
      </div>

      <aside class="bio__quote">
        <blockquote>
          <p class="bio__quote-text">
            "Cresci vendo minha avó colher café sozinha. Hoje o que eu colho é
            <em>possibilidade</em> pras filhas dela."
          </p>
          <footer>
            <cite>Elisângela Tomba</cite>
            <span>— Jundiaí do Sul, 2024</span>
          </footer>
        </blockquote>

        <div class="bio__pillars">
          {PILLARS.map((p) => (
            <article class="bio__pillar">
              <h3>{p.titulo}</h3>
              <p>{p.resumo}</p>
            </article>
          ))}
        </div>
      </aside>
    </div>
  </section>

  <!-- ====== DA HISTÓRIA À LUTA (texto corrido, sem timeline com bolinhas) ====== -->
  <section class="historia" aria-labelledby="historia-title">
    <div class="container">
      <header class="historia__header">
        <p class="bio__eyebrow">Da roça pra Assembleia</p>
        <h2 id="historia-title" class="historia__title">5 marcos que me trouxeram até aqui</h2>
      </header>

      <div class="historia__list">
        {TIMELINE.map((item) => (
          <article class="historia__item">
            <p class="historia__ano">{item.ano}</p>
            <div>
              <h3>{item.titulo}</h3>
              <p>{item.corpo}</p>
            </div>
          </article>
        ))}
      </div>

      <div class="historia__cta">
        <Button href="/sobre/" variant="primary" size="md">
          Ver tudo que eu já fiz
        </Button>
      </div>
    </div>
  </section>

  <!-- ====== CTA FINAL: tarja vermelha — whatsapp + slogan ====== -->
  <section class="cta-final" aria-labelledby="cta-title">
    <div class="container">
      <p class="cta-final__eyebrow">Fala comigo</p>
      <h2 id="cta-title" class="cta-final__title">
        Se essa história é sua também, bora juntas.
      </h2>
      <div class="cta-final__actions">
        <a
          class="wa-cta"
          href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Quero caminhar com você. Vim pelo site.')}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
          </svg>
          Manda mensagem no WhatsApp
        </a>
        <Button href="/apoie/" variant="secondary" size="lg">
          Outras formas de apoiar
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============ HERO ============ */
  .hero {
    padding-block: var(--space-12) var(--space-16);
    background: var(--papel);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__container {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-16);
    }
  }

  .hero__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border-left: var(--border-grossa) solid var(--carmin);
    padding-left: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .hero__title {
    font-family: var(--font-impacto);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: var(--tracking-pancada);
    text-transform: uppercase;
    color: var(--carvao);
    margin: 0 0 var(--space-5);
  }

  .hero__title-strike {
    color: var(--papel);
    background: var(--carmin);
    padding-inline: var(--space-1);
  }

  .hero__title-mark {
    color: var(--carmin);
  }

  .hero__tagline {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0 0 var(--space-7);
    max-width: 32rem;
  }

  .hero__tagline strong {
    color: var(--carvao);
    font-weight: var(--weight-bold);
    background: var(--estrela);
    padding-inline: 4px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-7);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    border-top: var(--border-fina) solid var(--carvao-medio);
    padding-top: var(--space-4);
  }

  .hero__badges li {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carvao-claro);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
  }

  .hero__badges li + li::before {
    content: "·";
    margin-right: var(--space-4);
    color: var(--carvao-medio);
  }

  /* Portrait */
  .hero__portrait {
    position: relative;
    margin: 0;
    aspect-ratio: 2/3;
    max-height: 640px;
    border: var(--border-grossa) solid var(--carvao);
    overflow: hidden;
    background: var(--carvao-medio);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: contrast(1.05) saturate(1.1);
  }

  .hero__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: var(--space-2) var(--space-3);
    background: var(--preto);
    color: var(--papel);
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
  }

  /* ============ FAIXA DIAGONAL ============ */
  .street-banner {
    background: var(--carmin);
    color: var(--papel);
    border-block: var(--border-grossa) solid var(--carvao);
    padding-block: var(--space-3);
    transform: rotate(-2deg);
    margin-block: var(--space-3);
    overflow: hidden;
  }

  .street-banner__track {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    white-space: nowrap;
    animation: marquee 30s linear infinite;
  }

  .street-banner__track > * {
    font-family: var(--font-impacto);
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  /* ============ BIO ============ */
  .bio {
    padding-block: var(--space-20);
    background: var(--papel-velho);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .bio__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  @media (min-width: 900px) {
    .bio__container {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--space-16);
    }
  }

  .bio__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin-bottom: var(--space-3);
  }

  .bio__title {
    font-family: var(--font-impacto);
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-5);
  }

  .bio__lead {
    font-family: var(--font-corpo);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--carvao);
    margin: 0 0 var(--space-4);
  }

  .bio__text p {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0 0 var(--space-4);
  }

  .bio__text strong { color: var(--carvao); font-weight: var(--weight-bold); }

  .bio__quote {
    border: var(--border-grossa) solid var(--carvao);
    background: var(--papel);
    padding: var(--space-7);
  }

  .bio__quote blockquote {
    margin: 0 0 var(--space-6);
    padding: 0;
    border-left: var(--border-grossa) solid var(--carmin);
    padding-left: var(--space-4);
  }

  .bio__quote-text {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--carvao);
    margin: 0;
  }

  .bio__quote em {
    color: var(--carmin);
    font-style: italic;
  }

  .bio__quote footer {
    margin-top: var(--space-3);
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao-claro);
  }

  .bio__quote cite {
    color: var(--carvao);
    font-style: normal;
    font-weight: var(--weight-bold);
    margin-right: var(--space-2);
  }

  .bio__pillars {
    border-top: var(--border-fina) solid var(--carvao-medio);
    padding-top: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .bio__pillar h3 {
    font-family: var(--font-impacto);
    font-size: var(--text-base);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carmin);
    margin: 0 0 var(--space-1);
  }

  .bio__pillar p {
    font-family: var(--font-corpo);
    font-size: var(--text-sm);
    color: var(--carvao-claro);
    margin: 0;
    line-height: var(--leading-snug);
  }

  /* ============ HISTÓRIA ============ */
  .historia {
    padding-block: var(--space-16);
    background: var(--papel);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .historia__header {
    margin-bottom: var(--space-10);
    border-bottom: var(--border-grossa) solid var(--carvao);
    padding-bottom: var(--space-5);
  }

  .historia__title {
    font-family: var(--font-impacto);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0;
  }

  .historia__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 56rem;
  }

  .historia__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
    padding-bottom: var(--space-5);
    border-bottom: var(--border-fina) solid var(--carvao-medio);
  }

  @media (min-width: 600px) {
    .historia__item {
      grid-template-columns: 10rem 1fr;
      gap: var(--space-7);
      align-items: start;
    }
  }

  .historia__ano {
    font-family: var(--font-impacto);
    font-size: var(--text-xl);
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin: 0;
  }

  .historia__item h3 {
    font-family: var(--font-impacto);
    font-size: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-2);
  }

  .historia__item p {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0;
  }

  .historia__cta {
    margin-top: var(--space-8);
  }

  /* ============ CTA FINAL ============ */
  .cta-final {
    padding-block: var(--space-16);
    background: var(--carmin);
    color: var(--papel);
    border-top: var(--border-grossa) solid var(--carvao);
  }

  .cta-final__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--estrela);
    margin: 0 0 var(--space-3);
    border-left: var(--border-grossa) solid var(--estrela);
    padding-left: var(--space-3);
  }

  .cta-final__title {
    font-family: var(--font-impacto);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--papel);
    margin: 0 0 var(--space-7);
    max-width: 32rem;
  }

  .cta-final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .wa-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-6);
    background: var(--papel);
    color: var(--carmin);
    border: var(--border-grossa) solid var(--papel);
    font-family: var(--font-impacto);
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    text-decoration: none;
    min-height: 56px;
  }

  .wa-cta:hover { background: var(--estrela); border-color: var(--estrela); }

  /* Botão "Outras formas de apoiar" no fundo vermelho precisa ser invertido */
  .cta-final :global(.btn--secondary) {
    color: var(--papel);
    background: var(--carmin-escuro);
    border-color: var(--papel);
  }
  .cta-final :global(.btn--secondary:hover) {
    background: var(--papel);
    color: var(--carmin);
    border-color: var(--papel);
  }
</style>
