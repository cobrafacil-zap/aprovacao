---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE, PILLARS, PROPOSALS, TIMELINE } from '../site.config.js';

const year = 2026;
---

<Layout
  title={`${SITE.name} — ${SITE.slogan} Candidata a Deputada Estadual pelo Paraná`}
  description={SITE.shortBio}
  pageType="profile"
>
  <!-- ====== HERO ====== -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__bg" aria-hidden="true"></div>
    <div class="hero__container container">
      <div class="hero__copy">
        <span class="hero__eyebrow">
          <span class="hero__eyebrow-dot" aria-hidden="true"></span>
          Eleições {year} · {SITE.party} · {SITE.state}
        </span>
        <h1 id="hero-title" class="hero__title">
          <span class="hero__title-name">Elisângela</span>
          <span class="hero__title-surname">Tomba</span>
        </h1>
        <p class="hero__role">Candidata a Deputada Estadual pelo Paraná</p>
        <p class="hero__tagline">
          Neta da Francisca. Filha da roça.<br />
          Assistente social. Fundadora da APAE de Jundiaí do Sul.<br />
          <strong>Agora é oficial — e essa história é de vocês.</strong>
        </p>
        <div class="hero__actions">
          <Button href="/propostas/" variant="primary" size="lg">
            Conheça minhas propostas
          </Button>
          <Button
            href={`https://wa.me/${SITE.contacts.whatsapp}?text=Ol%C3%A1%20Elis%C3%A2ngela%2C%20vim%20pelo%20site%20e%20quero%20conversar.`}
            variant="secondary"
            size="lg"
            external
          >
            Falar no WhatsApp
          </Button>
        </div>
        <ul class="hero__badges" aria-label="Identidade da campanha">
          <li>Assistente Social</li>
            <li>Norte Pioneiro do Paraná</li>
            <li>APAE Jundiaí do Sul</li>
        </ul>
      </div>

      <div class="hero__visual">
        <div class="hero__portrait">
          <img
            src="/images/hero-chamado-original.jpg"
            alt="Elisângela Tomba, de blazer vermelho, com a mão estendida em direção ao espectador, sorrindo — um chamado à ação"
            width="2400"
            height="3600"
            fetchpriority="high"
          />
          <div class="hero__portrait-decor" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== TRÊS PILARES ====== -->
  <section class="section section--alt" aria-labelledby="pillars-title">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">Os três pilares</span>
        <h2 id="pillars-title" class="section-title">
          O que a Elisângela quer <em>representar</em>
        </h2>
        <p class="section-lede">
          A identidade política da campanha é construída sobre três compromissos. Tudo que a Elisângela faz na Assembleia — e fora dela — volta a esses princípios.
        </p>
      </header>

      <div class="pillars-grid">
        {PILLARS.map((pillar, i) => (
          <article class="pillar" data-pillar={pillar.id}>
            <div class="pillar__number" aria-hidden="true">0{i + 1}</div>
            <h3 class="pillar__title">{pillar.title}</h3>
            <p class="pillar__summary">{pillar.summary}</p>
            <p class="pillar__body">{pillar.body}</p>
            <ul class="pillar__actions">
              {pillar.actions.map((a) => (
                <li>
                  <span class="pillar__bullet" aria-hidden="true">→</span>
                  <span>{a}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====== HISTÓRIA / TRAJETÓRIA ====== -->
  <section class="section" aria-labelledby="history-title">
    <div class="container">
      <header class="section-header section-header--center">
        <span class="eyebrow">De onde ela vem</span>
        <h2 id="history-title" class="section-title">
          Uma história feita de <em>café, algodão</em> e luta
        </h2>
      </header>

      <ol class="timeline">
        {TIMELINE.map((item) => (
          <li class="timeline__item">
            <div class="timeline__year">{item.year}</div>
            <div class="timeline__body">
              <h3 class="timeline__title">{item.title}</h3>
              <p class="timeline__text">{item.body}</p>
            </div>
          </li>
        ))}
      </ol>

      <div class="history-cta">
        <Button href="/sobre/" variant="dark" size="md">
          Leia a história completa
        </Button>
      </div>
    </div>
  </section>

  <!-- ====== PROPOSTAS (preview) ====== -->
  <section class="section section--alt" aria-labelledby="proposals-title">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow">O que ela defende</span>
        <h2 id="proposals-title" class="section-title">
          Propostas para um Paraná <em>de todas as gerações</em>
        </h2>
        <p class="section-lede">
          Sete eixos que orientam o mandato. Cada proposta foi pensada a partir da vida real das pessoas — do interior às cidades, do bebê ao idoso.
        </p>
      </header>

      <div class="proposals-grid">
        {PROPOSALS.slice(0, 6).map((p) => (
          <article class="proposal-card">
            <h3 class="proposal-card__title">{p.title}</h3>
            <p class="proposal-card__summary">{p.summary}</p>
            <ul class="proposal-card__list">
              {p.bullets.slice(0, 2).map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="section-cta">
        <Button href="/propostas/" variant="primary" size="md">
          Ver todas as propostas
        </Button>
      </div>
    </div>
  </section>

  <!-- ====== APOIE ====== -->
  <section class="section section--dark" aria-labelledby="support-title">
    <div class="container">
      <header class="section-header">
        <span class="eyebrow eyebrow--light">Como apoiar</span>
        <h2 id="support-title" class="section-title">
          Essa campanha é feita <em>com você</em>
        </h2>
        <p class="section-lede">
          Para chegar à Assembleia Legislativa, a Elisângela precisa de gente que acredita nessa história. Tem três formas de caminhar junto.
        </p>
      </header>

      <div class="support-grid">
        <a href="/apoie/#voluntario" class="support-card">
          <div class="support-card__icon" aria-hidden="true">🤝</div>
          <h3>Seja voluntário(a)</h3>
          <p>Ajude em panfletagem, eventos, redes sociais ou na articulação com sua comunidade. Cada pessoa faz diferença.</p>
          <span class="support-card__cta">Quero ajudar →</span>
        </a>

        <a href={SITE.integrations.donationUrl} class="support-card" rel="noopener">
          <div class="support-card__icon" aria-hidden="true">💚</div>
          <h3>Faça uma doação</h3>
          <p>Toda doação é registrada na Justiça Eleitoral. Sua contribuição ajuda a campanha a chegar nos 399 municípios do Paraná.</p>
          <span class="support-card__cta">Doar agora →</span>
        </a>

        <a
          href={`https://wa.me/${SITE.contacts.whatsapp}?text=Quero%20ajudar%20na%20campanha`}
          class="support-card"
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="support-card__icon" aria-hidden="true">📲</div>
          <h3>Divulgue e converse</h3>
          <p>Compartilhe o site, siga nas redes, mande esta história pra alguém que acredita. Boca a boca ainda é a melhor campanha.</p>
          <span class="support-card__cta">Falar no WhatsApp →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ====== CTA FINAL ====== -->
  <section class="section final-cta" aria-labelledby="final-cta-title">
    <div class="container container-text">
      <h2 id="final-cta-title" class="final-cta__title">
        <span class="final-cta__eyebrow">Agora é oficial</span>
        <em>Do Paraná que trabalha, com a força das mulheres, para quem mais precisa.</em>
      </h2>
      <p class="final-cta__body">
        Vote em Elisângela Tomba. <strong>{SITE.number ? `Número ${SITE.number}` : 'Número em breve'}</strong> — Deputada Estadual — {SITE.party}.
      </p>
      <div class="final-cta__actions">
        <Button href="/propostas/" variant="primary" size="lg">
          Ver propostas
        </Button>
        <Button href="/sobre/" variant="secondary" size="lg">
          Conhecer a história
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ====== HERO ====== */
  .hero {
    position: relative;
    padding-block: var(--space-16) var(--space-20);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(circle at 20% 0%, var(--color-rose-100) 0%, transparent 50%),
      radial-gradient(circle at 80% 100%, var(--color-sand-200) 0%, transparent 60%),
      var(--color-sand-50);
  }

  .hero__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__container {
      grid-template-columns: 1.1fr 1fr;
      gap: var(--space-16);
    }
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-rose-100);
    color: var(--color-red-700);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    border-radius: var(--radius-full);
    margin-bottom: var(--space-6);
  }

  .hero__eyebrow-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--color-red-500);
    border-radius: 50%;
    animation: pulse-dot 1.8s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__eyebrow-dot { animation: none; }
  }

  .hero__title {
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.95;
    margin: 0 0 var(--space-2);
    color: var(--color-brown-900);
  }

  .hero__title-name {
    display: block;
    font-weight: var(--weight-regular);
    font-style: italic;
  }

  .hero__title-surname {
    display: block;
    font-weight: var(--weight-black);
    color: var(--color-red-600);
  }

  .hero__role {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--weight-semibold);
    color: var(--color-brown-700);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-4);
  }

  .hero__tagline {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-brown-800);
    margin: 0 0 var(--space-8);
    max-width: 36rem;
  }

  .hero__tagline strong {
    color: var(--color-red-700);
    font-weight: var(--weight-bold);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .hero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hero__badges li {
    padding: var(--space-1) var(--space-3);
    background: var(--color-sand-100);
    color: var(--color-brown-700);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-full);
    border: 1px solid var(--color-sand-200);
  }

  /* Portrait */
  .hero__visual {
    position: relative;
  }

  .hero__portrait {
    position: relative;
    aspect-ratio: 2 / 3;
    max-height: 640px;
    margin-left: auto;
    border-radius: var(--radius-2xl);
    overflow: hidden;
    box-shadow: var(--shadow-xl);
  }

  .hero__portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero__portrait-decor {
    position: absolute;
    inset: -8px;
    border: 2px solid var(--color-red-500);
    border-radius: var(--radius-2xl);
    z-index: -1;
    transform: translate(-12px, 12px);
  }

  /* ====== SECTION HEADERS ====== */
  .section-header {
    margin-bottom: var(--space-12);
    max-width: 48rem;
  }

  .section-header--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-4);
    color: var(--color-brown-900);
  }

  .section-title em {
    font-style: italic;
    color: var(--color-red-600);
    font-weight: var(--weight-medium);
  }

  .section-lede {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-brown-700);
    margin: 0;
    max-width: 40rem;
  }

  .section-header--center .section-lede {
    margin-inline: auto;
  }

  .eyebrow--light {
    color: var(--color-red-300);
  }

  /* ====== PILARES ====== */
  .pillars-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 720px) {
    .pillars-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-6);
    }
  }

  .pillar {
    position: relative;
    background: var(--color-white);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-6);
    box-shadow: var(--shadow-sm);
    transition: all var(--duration-normal) var(--ease-out);
    border-top: 4px solid var(--color-red-500);
  }

  .pillar:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }

  .pillar:nth-child(2) { border-top-color: var(--color-rose-500); }
  .pillar:nth-child(3) { border-top-color: var(--color-brown-600); }

  .pillar__number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: var(--weight-black);
    color: var(--color-red-500);
    opacity: 0.3;
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .pillar__title {
    font-size: var(--text-2xl);
    margin: 0 0 var(--space-2);
    color: var(--color-brown-900);
  }

  .pillar__summary {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-md);
    color: var(--color-red-600);
    margin: 0 0 var(--space-4);
    font-weight: var(--weight-medium);
  }

  .pillar__body {
    color: var(--color-brown-800);
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .pillar__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-top: var(--space-4);
    border-top: 1px dashed var(--color-sand-200);
  }

  .pillar__actions li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-brown-700);
  }

  .pillar__bullet {
    color: var(--color-red-500);
    font-weight: var(--weight-bold);
    flex-shrink: 0;
  }

  /* ====== TIMELINE ====== */
  .timeline {
    position: relative;
    max-width: 56rem;
    margin-inline: auto;
    padding-left: var(--space-8);
  }

  .timeline::before {
    content: "";
    position: absolute;
    left: 0;
    top: var(--space-2);
    bottom: var(--space-2);
    width: 2px;
    background: var(--color-sand-200);
  }

  .timeline__item {
    position: relative;
    padding-bottom: var(--space-8);
  }

  .timeline__item::before {
    content: "";
    position: absolute;
    left: -2rem;
    top: var(--space-2);
    width: 14px;
    height: 14px;
    background: var(--color-red-500);
    border: 3px solid var(--color-sand-50);
    border-radius: 50%;
    margin-left: -7px;
    box-shadow: 0 0 0 2px var(--color-red-500);
  }

  .timeline__year {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-red-500);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-1);
  }

  .timeline__title {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-2);
    color: var(--color-brown-900);
  }

  .timeline__text {
    color: var(--color-brown-700);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .history-cta {
    text-align: center;
    margin-top: var(--space-8);
  }

  /* ====== PROPOSALS PREVIEW ====== */
  .proposals-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  @media (min-width: 640px) {
    .proposals-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (min-width: 960px) {
    .proposals-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .proposal-card {
    background: var(--color-white);
    border: 1px solid var(--color-sand-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .proposal-card:hover {
    border-color: var(--color-red-500);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .proposal-card__title {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-2);
    color: var(--color-red-700);
  }

  .proposal-card__summary {
    font-size: var(--text-sm);
    color: var(--color-brown-700);
    margin: 0 0 var(--space-3);
    line-height: var(--leading-relaxed);
  }

  .proposal-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-brown-600);
  }

  .proposal-card__list li {
    padding-left: var(--space-4);
    position: relative;
  }

  .proposal-card__list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-red-500);
    font-weight: var(--weight-bold);
  }

  .section-cta {
    text-align: center;
  }

  /* ====== SUPORTE ====== */
  .support-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 720px) {
    .support-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .support-card {
    display: flex;
    flex-direction: column;
    background: var(--color-brown-800);
    border: 1px solid var(--color-brown-700);
    border-radius: var(--radius-xl);
    padding: var(--space-8) var(--space-6);
    text-decoration: none;
    color: var(--color-sand-50);
    transition: all var(--duration-normal) var(--ease-out);
  }

  .support-card:hover {
    background: var(--color-brown-700);
    transform: translateY(-4px);
    box-shadow: var(--shadow-xl);
  }

  .support-card__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }

  .support-card h3 {
    font-size: var(--text-xl);
    margin: 0 0 var(--space-3);
    color: var(--color-sand-50);
  }

  .support-card p {
    color: var(--color-sand-200);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0 0 var(--space-4);
    flex: 1;
  }

  .support-card__cta {
    color: var(--color-red-300);
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
  }

  /* ====== CTA FINAL ====== */
  .final-cta {
    text-align: center;
    background: linear-gradient(135deg, var(--color-red-700), var(--color-red-500));
    color: var(--color-white);
  }

  .final-cta__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    color: var(--color-white);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-6);
  }

  .final-cta__eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--weight-bold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    margin-bottom: var(--space-3);
    opacity: 0.85;
  }

  .final-cta__title em {
    font-style: italic;
    color: var(--color-sand-200);
    font-weight: var(--weight-medium);
    display: block;
  }

  .final-cta__body {
    color: var(--color-white);
    font-size: var(--text-md);
    margin: 0 auto var(--space-8);
    max-width: 36rem;
  }

  .final-cta__body strong {
    font-weight: var(--weight-bold);
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }

  .final-cta__actions :global(.btn--secondary) {
    color: var(--color-white);
    border-color: var(--color-white);
  }

  .final-cta__actions :global(.btn--secondary:hover) {
    background: var(--color-white);
    color: var(--color-red-700);
  }
</style>
