---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site.config.js';
---

<Layout
  title="Contato — Elisângela Tomba"
  description="Fala com a campanha da Elisângela Tomba pelo WhatsApp, e-mail de imprensa ou redes sociais. Atendimento de imprensa, dúvidas, propostas e parcerias."
  pageType="website"
>
  <!-- ============ TOPO simples ============ -->
  <header class="topo">
    <div class="container">
      <p class="topo__eyebrow">Fala comigo</p>
      <h1 class="topo__titulo">Cinco canais. Cada um pro que é.</h1>
      <p class="topo__intro">
        Imprensa tem e-mail específico. Dúvidas gerais têm WhatsApp.
        Sobre proposta tem conversa. Não manda e-mail pra esperar WhatsApp —
        melhor caminho é mais rápido.
      </p>
    </div>
  </header>

  <!-- ============ BLOCO DESTAQUE WHATSAPP ============ -->
  <section class="whatsapp-bloco">
    <div class="container whatsapp-bloco__container">
      <div class="whatsapp-bloco__copy">
        <p class="whatsapp-bloco__eyebrow">O canal mais rápido</p>
        <h2 class="whatsapp-bloco__titulo">
          WhatsApp da campanha.
        </h2>
        <p class="whatsapp-bloco__sub">
          Resposta em até 24 horas úteis. Pra imprensa, prefere o e-mail
          específico (mais rápido). Pra apoio e voluntários, tem o formulário em <a href="/apoie/">/apoie/</a>.
        </p>
      </div>

      <a
        class="wa-cta-big"
        href={`https://wa.me/${SITE.contacts.whatsapp}?text=${encodeURIComponent('Olá Elisângela, vim pelo site.')}`}
        target="_blank" rel="noopener noreferrer"
      >
        <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        <span>
          <strong>{SITE.contacts.whatsappDisplay}</strong>
          <small>Abrir conversa no WhatsApp</small>
        </span>
      </a>
    </div>
  </section>

  <!-- ============ CANAIS (lista, não grid de cards) ============ -->
  <section class="canais" aria-label="Canais de contato">
    <div class="container">
      <ul class="canais__lista">
        <li>
          <span class="canais__num">02</span>
          <div>
            <h3>Imprensa</h3>
            <p>Releases, entrevistas, fotos em alta resolução, fala oficial da campanha.</p>
            <a class="canais__cta" href={`mailto:${SITE.contacts.press}`}>
              {SITE.contacts.press}
            </a>
          </div>
        </li>

        <li>
          <span class="canais__num">03</span>
          <div>
            <h3>Contato geral</h3>
            <p>Propostas, parcerias, dúvidas, convites para eventos.</p>
            <a class="canais__cta" href={`mailto:${SITE.contacts.email}`}>
              {SITE.contacts.email}
            </a>
          </div>
        </li>

        <li>
          <span class="canais__num">04</span>
          <div>
            <h3>Encarregado de Dados (DPO)</h3>
            <p>Direitos previstos na LGPD: acesso, correção, eliminação, portabilidade.</p>
            <a class="canais__cta" href="mailto:dpo@elisangelatomba.com.br">
              dpo@elisangelatomba.com.br
            </a>
          </div>
        </li>

        <li>
          <span class="canais__num">05</span>
          <div>
            <h3>Redes sociais</h3>
            <p>Acompanha a campanha no dia a dia. Comentários no Instagram são respondidos todo dia.</p>
            <ul class="canais__redes">
              <li><a href={SITE.contacts.instagram} target="_blank" rel="noopener noreferrer">Instagram · @elisangelatomba</a></li>
              {SITE.contacts.facebook && (
                <li><a href={SITE.contacts.facebook} target="_blank" rel="noopener noreferrer">Facebook · /elisangelatomba</a></li>
              )}
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </section>
</Layout>

<style>
  /* ============ TOPO ============ */
  .topo {
    padding-block: var(--space-16) var(--space-10);
    background: var(--papel);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .topo__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border-left: var(--border-grossa) solid var(--carmin);
    padding-left: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .topo__titulo {
    font-family: var(--font-impacto);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-5);
    max-width: 22ch;
  }

  .topo__intro {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    max-width: 38rem;
    margin: 0;
  }

  /* ============ WHATSAPP GRANDE ============ */
  .whatsapp-bloco {
    background: var(--verde-whatsapp);
    color: var(--papel);
    padding-block: var(--space-12);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .whatsapp-bloco__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 800px) {
    .whatsapp-bloco__container {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .whatsapp-bloco__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carvao);
    background: var(--papel);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    padding: var(--space-1) var(--space-3);
    display: inline-block;
    margin: 0 0 var(--space-3);
  }

  .whatsapp-bloco__titulo {
    font-family: var(--font-impacto);
    font-size: clamp(2rem, 5vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--papel);
    margin: 0 0 var(--space-4);
  }

  .whatsapp-bloco__sub {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--papel);
    margin: 0;
    max-width: 30rem;
  }

  .whatsapp-bloco__sub a {
    color: var(--carvao);
    background: var(--papel);
    padding-inline: 4px;
  }

  .wa-cta-big {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-7);
    background: var(--papel);
    color: var(--carvao);
    border: var(--border-grossa) solid var(--carvao);
    text-decoration: none;
    font-family: var(--font-impacto);
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
  }

  .wa-cta-big svg { color: var(--verde-whatsapp); flex-shrink: 0; }

  .wa-cta-big strong {
    display: block;
    color: var(--carvao);
    font-size: var(--text-lg);
    margin-bottom: 4px;
  }

  .wa-cta-big small {
    display: block;
    font-family: var(--font-corpo);
    font-size: var(--text-xs);
    text-transform: none;
    letter-spacing: 0;
    color: var(--carvao-claro);
  }

  .wa-cta-big:hover { background: var(--estrela); }

  /* ============ CANAIS ============ */
  .canais {
    padding-block: var(--space-12) var(--space-16);
    background: var(--papel);
  }

  .canais__lista {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: var(--border-grossa) solid var(--carvao);
  }

  .canais__lista > li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-bottom: var(--border-fina) solid var(--carvao-medio);
    align-items: start;
  }

  @media (min-width: 700px) {
    .canais__lista > li {
      grid-template-columns: 7rem 1fr;
      gap: var(--space-7);
      padding-block: var(--space-7);
    }
  }

  .canais__num {
    font-family: var(--font-impacto);
    font-size: var(--text-2xl);
    color: var(--carmin);
  }

  .canais__lista h3 {
    font-family: var(--font-impacto);
    font-size: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-2);
  }

  .canais__lista p {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    color: var(--carvao-claro);
    margin: 0 0 var(--space-3);
    line-height: var(--leading-relaxed);
  }

  .canais__cta {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    background: var(--papel-velho);
    color: var(--carvao);
    text-decoration: none;
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border: var(--border-media) solid var(--carvao);
  }

  .canais__cta:hover { background: var(--carmin); color: var(--papel); border-color: var(--carvao); }

  .canais__redes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .canais__redes a {
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carmin);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }
</style>
