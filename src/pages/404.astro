---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
---

<Layout
  title="Página não encontrada — Elisângela Tomba"
  description="A página que você procura não foi encontrada. Volta pra home que tá tudo certo."
  noindex={true}
>
  <section class="erro">
    <div class="erro__container container">
      <p class="erro__code">404</p>
      <h1 class="erro__titulo">Pareci que perdi o caminho.</h1>
      <p class="erro__corpo">
        A página que você procura não tá aqui. Talvez o link mudou, ou então
        a vó Francisca guardou errado. Volta pra home que tem tudo no lugar.
      </p>
      <div class="erro__acoes">
        <Button href="/" variant="primary" size="lg">Voltar pra home</Button>
        <Button href="/propostas/" variant="secondary" size="lg">Ler as 7 propostas</Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  .erro {
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: var(--papel);
    padding-block: var(--space-16);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .erro__container {
    text-align: left;
    max-width: 48rem;
  }

  .erro__code {
    font-family: var(--font-impacto);
    font-size: clamp(7rem, 25vw, 16rem);
    line-height: 0.85;
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin: 0 0 var(--space-5);
  }

  .erro__titulo {
    font-family: var(--font-impacto);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-5);
  }

  .erro__corpo {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0 0 var(--space-7);
    border-left: var(--border-grossa) solid var(--carmin);
    padding-left: var(--space-4);
  }

  .erro__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
