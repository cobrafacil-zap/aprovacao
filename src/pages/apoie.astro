---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { SITE } from '../site.config.js';
---

<Layout
  title="Apoie a campanha — Elisângela Tomba"
  description="Três formas de apoiar a campanha de Elisângela Tomba: seja voluntário, faça uma doação registrada na Justiça Eleitoral, ou divulgue."
  pageType="website"
>
  <section class="page-hero" aria-labelledby="page-title">
    <div class="container">
      <span class="eyebrow">Como apoiar</span>
      <h1 id="page-title" class="page-hero__title">
        Essa campanha é <em>feita com você</em>
      </h1>
      <p class="page-hero__lede">
        Para chegar à Assembleia Legislativa, a Elisângela precisa de gente que acredita nessa história. Três formas de caminhar junto — escolha a sua.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <!-- 1. Seja voluntário -->
      <article class="help-card" id="voluntario">
        <div class="help-card__icon" aria-hidden="true">🤝</div>
        <div class="help-card__body">
          <h2>Seja voluntário(a)</h2>
          <p>
            Ajude em panfletagem, eventos, redes sociais, redação de conteúdo, organização do comitê ou articulação com sua comunidade. Cada pessoa faz diferença — e cada tempo disponível é bem-vindo.
          </p>
          <ul class="help-card__list">
            <li>📍 Em Curitiba e Região Metropolitana</li>
            <li>🌾 No interior do Paraná — pode ser online</li>
            <li>📱 Nas redes sociais e grupos de WhatsApp</li>
            <li>✍️ Na produção de texto, fotos e vídeos</li>
          </ul>
          <form
            class="help-form"
            id="form-voluntario"
            action="#"
            method="post"
            aria-label="Formulário de cadastro de voluntário"
            data-form-type="voluntario"
          >
            <div class="form-row">
              <label>
                <span>Nome completo *</span>
                <input type="text" name="nome" required autocomplete="name" />
              </label>
              <label>
                <span>Cidade/Região *</span>
                <input type="text" name="cidade" required autocomplete="address-level2" />
              </label>
            </div>
            <div class="form-row">
              <label>
                <span>WhatsApp *</span>
                <input type="tel" name="whatsapp" required inputmode="tel" autocomplete="tel" placeholder="(00) 00000-0000" />
              </label>
              <label>
                <span>E-mail</span>
                <input type="email" name="email" autocomplete="email" />
              </label>
            </div>
            <fieldset class="form-fieldset">
              <legend>Como você quer ajudar?</legend>
              <label class="checkbox">
                <input type="checkbox" name="tipo" value="panfletagem" />
                <span>Panfletagem e materiais</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" name="tipo" value="redes" />
                <span>Redes sociais e comunicação</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" name="tipo" value="eventos" />
                <span>Eventos e comícios</span>
              </label>
              <label class="checkbox">
                <input type="checkbox" name="tipo" value="conteudo" />
                <span>Produção de conteúdo (texto, foto, vídeo)</span>
              </label>
            </fieldset>
            <label class="consent">
              <input type="checkbox" name="consentimento" required />
              <span>Concordo com a <a href="/politica-de-privacidade/">Política de Privacidade</a> e com o uso dos meus dados para receber contato da campanha. *</span>
            </label>
            <Button type="submit" variant="primary" size="md">Quero ser voluntário(a)</Button>
            <p class="form-message" role="status" aria-live="polite"></p>
          </form>
        </div>
      </article>

      <!-- 2. Doação -->
      <article class="help-card help-card--dark" id="doacao">
        <div class="help-card__icon" aria-hidden="true">💚</div>
        <div class="help-card__body">
          <h2>Faça uma doação</h2>
          <p>
            Toda doação é registrada na Justiça Eleitoral. Sua contribuição ajuda a campanha a chegar nos 399 municípios do Paraná. O limite de gastos para o cargo de Deputado Estadual em 2026 é de <strong>R$ 1.270.629,01</strong> — e cada real conta.
          </p>
          <p>
            A Elisângela usa apenas plataformas <strong>cadastradas no TSE</strong> para receber doações, conforme exige a lei. Em breve divulgaremos os links aqui.
          </p>
          <div class="donation-platforms">
            <p class="donation-platforms__title">Plataformas autorizadas pelo TSE para 2026:</p>
            <ul>
              <li>AppCívico</li>
              <li>Elegis</li>
              <li>GMT Tecnologia</li>
              <li>QueroApoiar</li>
            </ul>
          </div>
          <p class="donation-note">
            <strong>Importante:</strong> Pessoas jurídicas (empresas) não podem doar — apenas pessoas físicas, conforme a Lei das Eleições.
          </p>
          {SITE.integrations.donationUrl && SITE.integrations.donationUrl !== '#' ? (
            <Button href={SITE.integrations.donationUrl} variant="primary" size="lg" external>
              Doar agora
            </Button>
          ) : (
            <Button href={`https://wa.me/${SITE.contacts.whatsapp}?text=Quero%20fazer%20uma%20doa%C3%A7%C3%A3o`} variant="primary" size="lg" external>
              Falar sobre doação no WhatsApp
            </Button>
          )}
        </div>
      </article>

      <!-- 3. Divulgue -->
      <article class="help-card" id="divulgue">
        <div class="help-card__icon" aria-hidden="true">📲</div>
        <div class="help-card__body">
          <h2>Divulgue e converse</h2>
          <p>
            Boca a boca ainda é a melhor campanha. Siga nas redes, compartilhe o site, mande esta história para quem acredita. Cada pessoa que conhece a Elisângela amplia o alcance.
          </p>
          <div class="share-buttons">
            <a
              href={`https://api.whatsapp.com/send?text=${encodeURIComponent('Conheça a história de Elisângela Tomba, candidata a Deputada Estadual pelo Paraná: https://www.elisangelatomba.com.br')}`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn share-btn--wa"
            >
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Compartilhar no WhatsApp
            </a>
            <a
              href={`https://www.instagram.com/elisangelatomba`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn share-btn--ig"
            >
              Seguir no Instagram
            </a>
            <a
              href={`https://wa.me/${SITE.contacts.whatsapp}?text=Quero%20ajudar%20divulgando`}
              target="_blank"
              rel="noopener noreferrer"
              class="share-btn share-btn--ghost"
            >
              Falar no WhatsApp
            </a>
          </div>
        </div>
      </article>

    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-block: var(--space-20) var(--space-12);
    background: linear-gradient(180deg, var(--color-rose-100) 0%, var(--color-sand-50) 100%);
    text-align: center;
  }

  .page-hero__title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    margin: 0 auto var(--space-6);
    max-width: 32ch;
    line-height: var(--leading-tight);
  }

  .page-hero__title em {
    font-style: italic;
    color: var(--color-red-600);
  }

  .page-hero__lede {
    font-size: var(--text-md);
    color: var(--color-brown-700);
    max-width: 48rem;
    margin: 0 auto;
    line-height: var(--leading-relaxed);
  }

  .help-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    max-width: 56rem;
    margin: 0 auto var(--space-12);
    padding: var(--space-10);
    background: var(--color-white);
    border: 1px solid var(--color-sand-200);
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-md);
  }

  .help-card--dark {
    background: var(--color-brown-900);
    color: var(--color-sand-50);
    border-color: var(--color-brown-800);
  }

  .help-card--dark h2 { color: var(--color-sand-50); }
  .help-card--dark p { color: var(--color-sand-200); }
  .help-card--dark strong { color: var(--color-sand-50); }

  .help-card__icon {
    font-size: 3rem;
    line-height: 1;
  }

  .help-card__body h2 {
    font-size: var(--text-3xl);
    margin: 0 0 var(--space-3);
    color: var(--color-red-700);
  }

  .help-card__body p {
    margin: 0 0 var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .help-card__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding-left: 0;
  }

  .help-card__list li {
    color: var(--color-brown-700);
    padding-left: var(--space-1);
  }

  .donation-platforms {
    background: var(--color-sand-100);
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    margin: var(--space-4) 0;
  }

  .help-card--dark .donation-platforms {
    background: var(--color-brown-800);
  }

  .donation-platforms__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brown-800);
    margin: 0 0 var(--space-2);
  }

  .help-card--dark .donation-platforms__title {
    color: var(--color-sand-50);
  }

  .donation-platforms ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .donation-platforms li {
    padding: var(--space-1) var(--space-3);
    background: var(--color-white);
    color: var(--color-brown-900);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
  }

  .help-card--dark .donation-platforms li {
    background: var(--color-sand-50);
  }

  .donation-note {
    background: var(--color-rose-100);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    border-left: 3px solid var(--color-red-500);
    font-size: var(--text-sm);
    margin: var(--space-4) 0;
  }

  .help-card--dark .donation-note {
    background: var(--color-brown-700);
    color: var(--color-sand-50);
  }

  /* Formulário */
  .help-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-top: var(--space-6);
    border-top: 1px dashed var(--color-sand-200);
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 600px) {
    .form-row { grid-template-columns: 1fr 1fr; }
  }

  .help-form label {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brown-800);
  }

  .help-form input[type="text"],
  .help-form input[type="email"],
  .help-form input[type="tel"] {
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-sand-200);
    border-radius: var(--radius-md);
    font-size: var(--text-base);
    font-weight: var(--weight-normal);
    background: var(--color-white);
    color: var(--color-brown-900);
    transition: border-color var(--duration-fast);
  }

  .help-form input:focus {
    outline: none;
    border-color: var(--color-red-500);
  }

  .form-fieldset {
    border: 0;
    padding: 0;
    margin: 0;
  }

  .form-fieldset legend {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brown-800);
    margin-bottom: var(--space-2);
  }

  .checkbox {
    display: flex !important;
    flex-direction: row !important;
    align-items: center;
    gap: var(--space-2);
    font-weight: var(--weight-normal) !important;
    margin-bottom: var(--space-2);
  }

  .checkbox input {
    width: 18px;
    height: 18px;
    accent-color: var(--color-red-500);
  }

  .consent {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: var(--weight-normal) !important;
    color: var(--color-brown-700);
    line-height: var(--leading-snug);
  }

  .consent a {
    color: var(--color-red-600);
    text-decoration: underline;
  }

  .consent input {
    margin-top: 4px;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    accent-color: var(--color-red-500);
  }

  .form-message {
    margin: 0;
    padding: var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-align: center;
    display: none;
  }

  .form-message[data-state="success"] {
    display: block;
    background: #DCFCE7;
    color: #166534;
    border: 1px solid #86EFAC;
  }

  .form-message[data-state="error"] {
    display: block;
    background: var(--color-rose-100);
    color: var(--color-red-700);
    border: 1px solid var(--color-rose-300);
  }

  /* Share */
  .share-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-5);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transition: all var(--duration-fast);
  }

  .share-btn--wa {
    background: #25D366;
    color: var(--color-white);
  }

  .share-btn--ig {
    background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
    color: var(--color-white);
  }

  .share-btn--ghost {
    background: var(--color-sand-100);
    color: var(--color-brown-800);
  }

  .share-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-md);
  }
</style>

<script>
  // Formulário de voluntário: validação e feedback visual
  // Em produção, substituir pelo POST para um endpoint (ex: serverless function, Supabase, etc.)
  const form = document.getElementById('form-voluntario') as HTMLFormElement | null;
  const message = form?.querySelector('.form-message') as HTMLElement | null;

  if (form && message) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const consentimento = (form.querySelector('input[name="consentimento"]') as HTMLInputElement)?.checked;

      if (!consentimento) {
        message.textContent = 'Você precisa concordar com a Política de Privacidade para enviar.';
        message.setAttribute('data-state', 'error');
        return;
      }

      // Aqui entraria o POST real. Por enquanto, simula sucesso.
      message.textContent = '✅ Recebemos seu cadastro! Em breve a equipe da campanha entra em contato pelo WhatsApp. Obrigado(a)!';
      message.setAttribute('data-state', 'success');
      form.reset();
    });
  }
</script>
