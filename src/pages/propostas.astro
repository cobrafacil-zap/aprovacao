---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import { PROPOSALS } from '../site.config.js';
---

<Layout
  title="Propostas — Elisângela Tomba"
  description="Os 7 eixos de luta da campanha da Elisângela Tomba, candidata a Deputada Estadual pelo Paraná: educação, mulheres, pessoa idosa, deficiência, saúde, trabalho e cultura."
  pageType="website"
>
  <!-- Sem page-hero. Título colado no papel, denso de panfleto -->
  <header class="topo">
    <div class="container">
      <p class="topo__eyebrow">Carta de compromissos · Eleições 2026</p>
      <h1 class="topo__title">7 coisas que eu vou <span class="topo__mark">lutar</span>.</h1>
      <p class="topo__intro">
        Cada compromisso aqui nasceu de quem me procurou — mãe solteira do
        Centro de Jacarezinho, criança que perdeu o atendimento na APAE,
        avó esperando cirurgia há 8 meses. Não são promessas: são caminhos
        que eu já andei na prática.
      </p>
      <p class="topo__citation">
        — Elisângela Tomba, <time datetime="2026-08-26">agosto de 2026</time>
      </p>
    </div>
  </header>

  <!-- Lista numerada, sem cards simétricos — cada proposta é sua própria página -->
  <section class="lista" aria-label="Os 7 eixos">
    {PROPOSALS.map((p, i) => (
      <article
        class={`proposta proposta--${p.id}`}
        id={p.id}
        aria-labelledby={`titulo-${p.id}`}
        data-i={i}
      >
        <div class="container proposta__container">
          <header class="proposta__cabecalho">
            <div class="proposta__numero">{p.numero}</div>
            <h2 id={`titulo-${p.id}`} class="proposta__titulo">{p.titulo}</h2>
          </header>

          <p class="proposta__intro">{p.intro}</p>

          <div class="proposta__corpo">
            {p.corpo.map((frase) => (
              <p>{frase}</p>
            ))}
          </div>
        </div>
      </article>
    ))}
  </section>

  <!-- Fechamento — tarja preta, sem card -->
  <section class="fechamento" aria-labelledby="fechamento-titulo">
    <div class="container">
      <p class="fechamento__eyebrow">Como isso vira lei</p>
      <h2 id="fechamento-titulo" class="fechamento__titulo">
        Três caminhos: <em>lei</em>, <em>orçamento</em>, <em>pressão</em>.
      </h2>
      <ul class="fechamento__lista">
        <li>
          <span class="fechamento__num">01</span>
          <div>
            <h3>Propondo leis</h3>
            <p>A Assembleia Legislativa do Paraná vota projetos de lei estaduais. Mandato é 4 anos com nome no boletim de voto: dá pra cobrar.</p>
          </div>
        </li>
        <li>
          <span class="fechamento__num">02</span>
          <div>
            <h3>Articulando orçamento</h3>
            <p>Deputado estadual vota a Lei Orçamentária Anual. Cada rubrica tem nome de quem defende: criança, mulher, idoso, pessoa com deficiência.</p>
          </div>
        </li>
        <li>
          <span class="fechamento__num">03</span>
          <div>
            <h3>Pressionando políticas</h3>
            <p>De cadeira em comissão, de audiência pública, de marcha no interior. Política vira política quando tem gente em cima.</p>
          </div>
        </li>
      </ul>

      <div class="fechamento__acoes">
        <Button
          href={`https://wa.me/5546999999999?text=${encodeURIComponent('Tô com você. Me conta uma dessas 7 propostas que eu quero entender melhor.')}`}
          variant="primary"
          size="lg"
          external
        >
          Quero saber mais sobre uma proposta
        </Button>
        <Button href="/apoie/" variant="secondary" size="md">
          Como apoiar
        </Button>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ============ TOPO (sem hero — denso de papel) ============ */
  .topo {
    background: var(--papel);
    padding-block: var(--space-16) var(--space-10);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .topo__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border-bottom: var(--border-media) solid var(--carmin);
    padding-bottom: var(--space-2);
    margin-bottom: var(--space-6);
    display: inline-block;
  }

  .topo__title {
    font-family: var(--font-impacto);
    font-size: clamp(2.75rem, 9vw, 6rem);
    line-height: 0.9;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0 0 var(--space-6);
    max-width: 22ch;
  }

  .topo__mark {
    background: var(--carmin);
    color: var(--papel);
    padding-inline: 6px;
  }

  .topo__intro {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0 0 var(--space-5);
    max-width: 38rem;
  }

  .topo__citation {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--carvao-medio);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin: 0;
  }

  /* ============ LISTA DE PROPOSTAS ============ */
  .lista {
    background: var(--papel);
    padding-block: var(--space-16);
  }

  .proposta {
    padding-block: var(--space-12);
    border-top: var(--border-grossa) solid var(--carvao);
  }

  .proposta:nth-child(even) {
    background: var(--papel-velho);
  }

  .proposta:nth-child(odd) {
    background: var(--papel);
  }

  .proposta__container {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .proposta__container {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-12);
    }
  }

  .proposta__cabecalho {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
  }

  .proposta__numero {
    font-family: var(--font-impacto);
    font-size: clamp(4rem, 8vw, 5.5rem);
    line-height: 0.8;
    color: var(--carmin);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    flex-shrink: 0;
  }

  .proposta__titulo {
    font-family: var(--font-impacto);
    font-size: clamp(1.5rem, 3vw, 2rem);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin: 0;
    max-width: 18ch;
  }

  .proposta__intro {
    font-family: var(--font-manuscrita);
    font-style: italic;
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--carvao-claro);
    margin: 0;
    border-left: var(--border-grossa) solid var(--carmin);
    padding-left: var(--space-4);
  }

  .proposta__corpo {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--carvao);
    max-width: 38rem;
  }

  .proposta__corpo p {
    margin: 0;
    padding-left: var(--space-5);
    position: relative;
  }

  .proposta__corpo p::before {
    content: "→";
    position: absolute;
    left: 0;
    color: var(--carmin);
    font-weight: var(--weight-bold);
  }

  /* ============ FECHAMENTO (tarja preta) ============ */
  .fechamento {
    background: var(--preto);
    color: var(--papel);
    padding-block: var(--space-16);
    border-top: var(--border-grossa) solid var(--carvao);
  }

  .fechamento__eyebrow {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    color: var(--estrela);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin-bottom: var(--space-3);
  }

  .fechamento__titulo {
    font-family: var(--font-impacto);
    font-size: clamp(1.75rem, 5vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--papel);
    margin: 0 0 var(--space-10);
    max-width: 22ch;
  }

  .fechamento__titulo em {
    color: var(--estrela);
    font-style: normal;
  }

  .fechamento__lista {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-bottom: var(--space-10);
  }

  .fechamento__lista > li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-4);
    border-top: var(--border-fina) solid var(--carvao-medio);
  }

  .fechamento__num {
    font-family: var(--font-impacto);
    font-size: var(--text-2xl);
    color: var(--estrela);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
  }

  .fechamento__lista h3 {
    font-family: var(--font-impacto);
    font-size: var(--text-lg);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--papel);
    margin: 0 0 var(--space-2);
  }

  .fechamento__lista p {
    font-family: var(--font-corpo);
    font-size: var(--text-base);
    color: var(--papel-saco);
    margin: 0;
    line-height: var(--leading-relaxed);
  }

  .fechamento__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .fechamento__acoes :global(.btn--secondary) {
    background: var(--carvao);
    color: var(--papel);
    border-color: var(--carvao);
  }
  .fechamento__acoes :global(.btn--secondary:hover) {
    background: var(--papel-saco);
    color: var(--preto);
  }
</style>
