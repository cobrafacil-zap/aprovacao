---
/**
 * Banner de Cookies — versão campanha popular
 *
 * Mudanças da v2:
 * - Tarja preta full-width embaixo (não card branco com sombra)
 * - 2 botões principais ("Aceitar" e "Recusar"), mesmo peso visual
 * - Sem emoji 🍪
 * - Sem delay de 1.5s (mostra imediatamente se não há consentimento)
 * - LGPD ainda atendido: rejeição tão fácil quanto aceitação
 */

import { SITE } from '../site.config.js';
---

<aside
  id="cookie-banner"
  class="cookie-banner"
  role="region"
  aria-label="Aviso de cookies e privacidade"
  aria-live="polite"
  data-cookie-banner
  hidden
>
  <div class="cookie-banner__inner container">
    <div class="cookie-banner__copy">
      <h2 class="cookie-banner__title">Este site usa cookies</h2>
      <p>
        Usamos cookies essenciais pro site funcionar e, com seu consentimento, cookies de análise (Google Analytics) pra entender quem visita. Você pode aceitar ou recusar agora — ou configurar depois.
        <a href="/politica-de-privacidade/#cookies">Saiba mais</a>.
      </p>
    </div>

    <div class="cookie-banner__actions" role="group" aria-label="Escolhas sobre cookies">
      <button class="cookie-btn cookie-btn--ghost" data-cookie-action="configure" type="button">
        Configurar
      </button>
      <button class="cookie-btn cookie-btn--outline" data-cookie-action="reject" type="button">
        Recusar
      </button>
      <button class="cookie-btn cookie-btn--primary" data-cookie-action="accept" type="button">
        Aceitar
      </button>
    </div>
  </div>

  <div class="cookie-banner__panel" id="cookie-panel" hidden>
    <div class="container cookie-banner__panel-inner">
      <h3>Configurar cookies</h3>
      <ul class="cookie-options">
        <li>
          <label>
            <input type="checkbox" checked disabled />
            <span>
              <strong>Essenciais</strong>
              <small>Necessários pro site funcionar. Sempre ativos.</small>
            </span>
          </label>
        </li>
        <li>
          <label>
            <input type="checkbox" data-cookie-pref="analytics" />
            <span>
              <strong>Análise</strong>
              <small>Google Analytics 4. Ajuda a entender quem visita.</small>
            </span>
          </label>
        </li>
        <li>
          <label>
            <input type="checkbox" data-cookie-pref="marketing" />
            <span>
              <strong>Marketing</strong>
              <small>Meta Pixel (Facebook/Instagram). Medir alcance de campanhas.</small>
            </span>
          </label>
        </li>
      </ul>
      <button class="cookie-btn cookie-btn--primary" data-cookie-action="save-prefs" type="button">
        Salvar preferências
      </button>
    </div>
  </div>
</aside>

<script>
  type CookieChoice = 'all' | 'essential' | Record<string, boolean>;
  const STORAGE_KEY = 'et-cookie-consent';
  const banner = document.querySelector('[data-cookie-banner]') as HTMLElement | null;
  const panel = document.getElementById('cookie-panel');

  function loadConsent(): CookieChoice | null {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return null;
      return JSON.parse(raw);
    } catch {
      return null;
    }
  }

  function saveConsent(choice: CookieChoice) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({
        choice,
        timestamp: new Date().toISOString(),
      }));
    } catch {
      // localStorage indisponível
    }
    applyConsent(choice);
  }

  function applyConsent(choice: CookieChoice) {
    const allowed = choice === 'all'
      ? { analytics: true, marketing: true }
      : choice === 'essential'
        ? { analytics: false, marketing: false }
        : { analytics: !!choice.analytics, marketing: !!choice.marketing };

    document.dispatchEvent(new CustomEvent('cookie-consent', { detail: allowed }));

    if (banner) banner.hidden = true;
    if (panel) panel.hidden = true;
  }

  if (!loadConsent()) {
    if (banner) banner.hidden = false;
  } else {
    applyConsent(loadConsent() as CookieChoice);
  }

  if (banner) {
    banner.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const action = target.dataset.cookieAction;
      if (!action) return;

      if (action === 'accept') saveConsent('all');
      if (action === 'reject') saveConsent('essential');
      if (action === 'configure') {
        if (panel) panel.hidden = !panel.hidden;
      }
      if (action === 'save-prefs') {
        const analytics = (banner.querySelector('[data-cookie-pref="analytics"]') as HTMLInputElement | null)?.checked ?? false;
        const marketing = (banner.querySelector('[data-cookie-pref="marketing"]') as HTMLInputElement | null)?.checked ?? false;
        saveConsent({ analytics, marketing });
      }
    });
  }

  (window as any).reabrirPreferenciasCookies = () => {
    if (banner) banner.hidden = false;
    if (panel) panel.hidden = false;
  };
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-cookie);
    background: var(--preto);
    color: var(--papel);
    border-top: var(--border-grossa) solid var(--estrela);
  }

  .cookie-banner[hidden] { display: none; }

  .cookie-banner__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-block: var(--space-4);
  }

  @media (min-width: 768px) {
    .cookie-banner__inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-5);
    }
  }

  .cookie-banner__copy { flex: 1; }

  .cookie-banner__title {
    font-family: var(--font-impacto);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    color: var(--estrela);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin-bottom: var(--space-1);
  }

  .cookie-banner__copy p {
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--papel);
    margin: 0;
  }

  .cookie-banner__copy a {
    color: var(--estrela);
    text-decoration-color: var(--estrela);
  }

  .cookie-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .cookie-btn {
    padding: var(--space-2) var(--space-4);
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border: var(--border-grossa) solid var(--papel);
    cursor: pointer;
    transition: background-color var(--transition-rapida), color var(--transition-rapida);
    min-height: 40px;
  }

  .cookie-btn--primary {
    background: var(--estrela);
    color: var(--preto);
    border-color: var(--estrela);
  }
  .cookie-btn--primary:hover {
    background: var(--estrela-velho);
    border-color: var(--estrela-velho);
  }

  .cookie-btn--outline {
    background: transparent;
    color: var(--papel);
    border-color: var(--papel);
  }
  .cookie-btn--outline:hover {
    background: var(--papel);
    color: var(--preto);
  }

  .cookie-btn--ghost {
    background: transparent;
    color: var(--papel-saco);
    border-color: transparent;
  }
  .cookie-btn--ghost:hover {
    color: var(--estrela);
  }

  /* Painel de configuração */
  .cookie-banner__panel {
    border-top: var(--border-fina) solid var(--carvao-medio);
  }

  .cookie-banner__panel[hidden] { display: none; }

  .cookie-banner__panel-inner {
    padding-block: var(--space-4);
  }

  .cookie-banner__panel h3 {
    font-family: var(--font-impacto);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    color: var(--estrela);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin-bottom: var(--space-3);
  }

  .cookie-options {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .cookie-options label {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    background: var(--carvao);
    cursor: pointer;
  }

  .cookie-options input {
    width: 18px;
    height: 18px;
    accent-color: var(--estrela);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .cookie-options strong {
    display: block;
    font-weight: var(--weight-bold);
    font-size: var(--text-sm);
    color: var(--papel);
  }

  .cookie-options small {
    display: block;
    font-size: var(--text-xs);
    color: var(--papel-saco);
    margin-top: 2px;
  }
</style>
