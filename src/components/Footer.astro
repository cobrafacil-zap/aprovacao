---
/**
 * Footer — versão campanha popular
 *
 * Mudanças da v2:
 * - Fundo bege (não marrom-escuro SaaS)
 * - Sem licença Creative Commons em destaque
 * - 3 colunas simples
 * - Identificação legal obrigatória preservada (LGPD + TSE)
 */

import { SITE } from '../site.config.js';
const year = new Date().getFullYear();
---

<footer class="footer" role="contentinfo">
  <div class="footer__top container">
    <div class="footer__brand">
      <span class="footer__mark" aria-hidden="true">
        <svg width="56" height="56" viewBox="0 0 100 100">
          <rect width="100" height="100" fill="#C8102E"/>
          <polygon points="50,18 57,40 80,40 61,52 68,74 50,62 32,74 39,52 20,40 43,40" fill="#FFCD00"/>
        </svg>
      </span>
      <div>
        <p class="footer__name">Elisângela Tomba</p>
        <p class="footer__role">Candidata a Deputada Estadual pelo Paraná</p>
        <p class="footer__party">{SITE.party} — Partido dos Trabalhadores</p>
      </div>
    </div>

    <div class="footer__columns">
      <nav class="footer__col" aria-label="Navegação do rodapé">
        <h2 class="footer__col-title">Site</h2>
        <ul>
          <li><a href="/sobre/">Sobre</a></li>
          <li><a href="/propostas/">Propostas</a></li>
          <li><a href="/apoie/">Apoie</a></li>
          <li><a href="/contato/">Contato</a></li>
        </ul>
      </nav>

      <div class="footer__col">
        <h2 class="footer__col-title">Apoie</h2>
        <ul>
          <li><a href="/apoie/#voluntario">Seja voluntário(a)</a></li>
          <li><a href="/apoie/#doacao">Faça uma doação</a></li>
          <li><a href={SITE.contacts.instagram} target="_blank" rel="noopener noreferrer">Instagram</a></li>
          <li><a href={`https://wa.me/${SITE.contacts.whatsapp}`} target="_blank" rel="noopener noreferrer">WhatsApp</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h2 class="footer__col-title">Contato</h2>
        <address>
          <p>Imprensa: <a href={`mailto:${SITE.contacts.press}`}>{SITE.contacts.press}</a></p>
          <p>Geral: <a href={`mailto:${SITE.contacts.email}`}>{SITE.contacts.email}</a></p>
          <p>WhatsApp: <a href={`https://wa.me/${SITE.contacts.whatsapp}`} target="_blank" rel="noopener noreferrer">{SITE.contacts.whatsappDisplay}</a></p>
        </address>
      </div>
    </div>
  </div>

  <div class="footer__legal">
    <div class="container footer__legal-inner">
      <div class="footer__legal-row">
        <p>
          <strong>Propaganda Eleitoral</strong> — CNPJ campanha: {SITE.legal.cnpjCampanha}
        </p>
        <p>
          Autorizada por <strong>{SITE.legal.autorizadoPor}</strong>
        </p>
      </div>

      <div class="footer__legal-row">
        <p>Encarregado de Dados (DPO): <a href="mailto:dpo@elisangelatomba.com.br">dpo@elisangelatomba.com.br</a></p>
        <p>
          <a href="#" onclick="event.preventDefault(); window.reabrirPreferenciasCookies && window.reabrirPreferenciasCookies();">Cookies</a>
          ·
          <a href="/politica-de-privacidade/">Política de Privacidade</a>
        </p>
      </div>

      <p class="footer__copyright">
        © {year} Elisângela Tomba · Conteúdo sob licença Creative Commons (CC BY-NC 4.0)
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--papel);
    color: var(--carvao);
    border-top: var(--border-grossa) solid var(--carvao);
  }

  .footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    padding-block: var(--space-8);
  }

  @media (min-width: 768px) {
    .footer__top {
      grid-template-columns: 1fr 2fr;
      gap: var(--space-8);
    }
  }

  .footer__brand {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .footer__mark {
    flex-shrink: 0;
    line-height: 0;
  }

  .footer__name {
    font-family: var(--font-impacto);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
    margin-bottom: var(--space-1);
  }

  .footer__role,
  .footer__party {
    font-size: var(--text-sm);
    color: var(--carvao-claro);
    margin: 0;
  }

  .footer__columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-6);
  }

  .footer__col-title {
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--carvao);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    margin-bottom: var(--space-3);
    border-bottom: var(--border-media) solid var(--carvao);
    padding-bottom: var(--space-2);
  }

  .footer__col ul,
  .footer__col address {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-style: normal;
  }

  .footer__col a {
    font-size: var(--text-sm);
    color: var(--carvao-claro);
    text-decoration-color: var(--carvao);
  }

  .footer__col a:hover {
    color: var(--carmin);
  }

  .footer__col p {
    font-size: var(--text-sm);
    color: var(--carvao-claro);
    margin: 0;
  }

  /* Bloco legal — tarja preta fina */
  .footer__legal {
    background: var(--preto);
    color: var(--papel);
    padding-block: var(--space-5);
  }

  .footer__legal-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__legal-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    align-items: baseline;
  }

  .footer__legal p {
    font-size: var(--text-xs);
    color: var(--papel);
    margin: 0;
  }

  .footer__legal strong {
    color: var(--estrela);
    font-weight: var(--weight-bold);
  }

  .footer__legal a {
    color: var(--papel);
    text-decoration-color: var(--carmin);
    text-decoration-thickness: 2px;
  }

  .footer__legal a:hover {
    color: var(--estrela);
  }

  .footer__copyright {
    font-size: var(--text-xs);
    color: var(--papel-saco);
    border-top: 1px solid var(--carvao-medio);
    padding-top: var(--space-3);
    margin-top: var(--space-2);
  }
</style>
