---
/**
 * Header fixo — versão campanha popular
 *
 * Mudanças da v2:
 * - Sem backdrop-filter (header sólido)
 * - Logo é estrela do PT amarela em vez de "ET" quadrado
 * - Hover de link muda cor (não background)
 * - WhatsApp CTA sem sombra colorida, só chapado
 */

import { NAV, SITE } from '../site.config.js';
---

<header class="header" role="banner">
  <div class="header__inner container">
    <a href="/" class="header__brand" aria-label="Página inicial — Elisângela Tomba">
      <span class="header__brand-mark" aria-hidden="true">
        <svg width="36" height="36" viewBox="0 0 100 100" aria-hidden="true">
          <rect width="100" height="100" fill="#C8102E"/>
          <polygon points="50,18 57,40 80,40 61,52 68,74 50,62 32,74 39,52 20,40 43,40" fill="#FFCD00"/>
        </svg>
      </span>
      <span class="header__brand-text">
        <strong class="header__brand-name">Elisângela Tomba</strong>
        <span class="header__brand-role">Deputada Estadual · PT/Paraná</span>
      </span>
    </a>

    {SITE.number && (
      <a href="#vote" class="header__number" aria-label="Vote 13579 — Deputada Estadual">
        <span class="header__number-label">Vote</span>
        <span class="header__number-digits">{SITE.number}</span>
      </a>
    )}

    <button
      class="header__toggle"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav class="header__nav" id="primary-nav" aria-label="Navegação principal" data-menu>
      <ul class="header__nav-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class="header__nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <a
        class="header__nav-cta"
        href={`https://wa.me/${SITE.contacts.whatsapp}?text=Ol%C3%A1%20Elis%C3%A2ngela%2C%20vim%20pelo%20site%20e%20quero%20conversar.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com a Elisângela no WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        Fala comigo
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--papel);
    border-bottom: var(--border-grossa) solid var(--carvao);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 72px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--carvao);
  }

  .header__brand-mark {
    display: inline-flex;
    flex-shrink: 0;
    line-height: 0;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .header__brand-name {
    font-family: var(--font-impacto);
    font-weight: var(--weight-regular);
    font-size: var(--text-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--carvao);
  }

  .header__brand-role {
    font-size: var(--text-xs);
    color: var(--carvao-claro);
    font-weight: var(--weight-bold);
  }

  /* Badge do número — âncora visual no header pra "Vote 13579" */
  .header__number {
    display: none;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--carmin);
    color: var(--papel);
    text-decoration: none;
    border: var(--border-grossa) solid var(--carvao);
    line-height: 1;
    transition: background-color var(--transition-rapida);
  }

  .header__number:hover { background: var(--carmin-escuro); }

  .header__number-label {
    font-family: var(--font-impacto);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    color: var(--estrela);
  }

  .header__number-digits {
    font-family: var(--font-impacto);
    font-size: var(--text-lg);
    font-weight: var(--weight-regular);
    color: var(--papel);
    letter-spacing: 0.05em;
  }

  @media (min-width: 540px) { .header__number { display: inline-flex; } }
  @media (max-width: 880px) {
    .header__number { display: none; }
  }
  @media (min-width: 881px) {
    .header__number { display: inline-flex; }
  }

  .header__nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .header__nav-link {
    display: inline-block;
    padding: var(--space-1) 0;
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    color: var(--carvao);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    text-decoration: none;
    border-bottom: var(--border-grossa) solid transparent;
    transition: border-color var(--transition-rapida);
  }

  .header__nav-link:hover {
    border-bottom-color: var(--carmin);
    color: var(--carmin);
  }

  .header__nav-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--verde-whatsapp);
    color: var(--branco);
    font-family: var(--font-impacto);
    font-size: var(--text-sm);
    font-weight: var(--weight-regular);
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    text-decoration: none;
    border: var(--border-grossa) solid var(--carvao);
  }

  .header__nav-cta:hover {
    background: var(--verde-whatsapp-hover);
  }

  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 22px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .header__toggle-bar {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--carvao);
    transition: opacity var(--transition-rapida);
  }

  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }

  @media (max-width: 880px) {
    .header__nav[data-menu][data-open="true"] {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--papel);
      border-bottom: var(--border-grossa) solid var(--carvao);
      padding: var(--space-5);
      gap: var(--space-3);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-2);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-link {
      display: block;
      padding: var(--space-2) 0;
      font-size: var(--text-md);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-cta {
      margin-top: var(--space-3);
      justify-content: center;
      padding: var(--space-3) var(--space-5);
    }
    .header__inner {
      position: relative;
    }
  }

  @media (min-width: 881px) {
    .header__toggle { display: none; }
    .header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-5);
    }
  }

  @media (max-width: 480px) {
    .header__brand-role { display: none; }
    .header__brand-name { font-size: var(--text-base); }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-menu]') as HTMLElement | null;

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
      if (!open) menu.setAttribute('data-open', 'true');
      else menu.removeAttribute('data-open');
    });

    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu de navegação');
        menu.removeAttribute('data-open');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.hasAttribute('data-open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu de navegação');
        menu.removeAttribute('data-open');
        toggle.focus();
      }
    });
  }
</script>
