---
/**
 * Header fixo com navegação
 * Mobile-first: menu hambúrguer
 * Acessível: aria-labels, navegação por teclado, foco visível
 */

import { NAV, SITE } from '../site.config.js';
---

<header class="header" role="banner">
  <div class="header__inner container">
    <a href="/" class="header__brand" aria-label="Página inicial — Elisângela Tomba">
      <span class="header__brand-mark" aria-hidden="true">ET</span>
      <span class="header__brand-text">
        <strong>Elisângela Tomba</strong>
        <span class="header__brand-role">Deputada Estadual · PT/Paraná</span>
      </span>
    </a>

    <button
      class="header__toggle"
      aria-label="Abrir menu de navegação"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-menu-toggle
    >
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
      <span class="header__toggle-bar"></span>
    </button>

    <nav class="header__nav" id="primary-nav" aria-label="Navegação principal" data-menu>
      <ul class="header__nav-list">
        {NAV.map((item) => (
          <li>
            <a href={item.href} class="header__nav-link">{item.label}</a>
          </li>
        ))}
      </ul>
      <a
        class="header__nav-cta"
        href={`https://wa.me/${SITE.contacts.whatsapp}?text=Ol%C3%A1%20Elis%C3%A2ngela%2C%20vim%20pelo%20site%20e%20quero%20conversar.`}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Falar com a campanha no WhatsApp"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
        </svg>
        WhatsApp
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--color-sand-50);
    border-bottom: 1px solid var(--color-sand-200);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 72px;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--color-brown-900);
    font-family: var(--font-sans);
  }

  .header__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: var(--color-red-500);
    color: var(--color-white);
    font-family: var(--font-serif);
    font-weight: var(--weight-black);
    font-size: var(--text-md);
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }

  .header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }

  .header__brand-text strong {
    font-weight: var(--weight-bold);
    font-size: var(--text-md);
  }

  .header__brand-role {
    font-size: var(--text-xs);
    color: var(--color-brown-700);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    font-weight: var(--weight-semibold);
  }

  .header__nav {
    display: none;
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
  }

  .header__nav-link {
    display: inline-block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-brown-800);
    border-radius: var(--radius-md);
    transition: all var(--duration-fast) var(--ease-out);
  }

  .header__nav-link:hover {
    color: var(--color-red-600);
    background: var(--color-sand-100);
  }

  .header__nav-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-4);
    background: var(--color-red-500);
    color: var(--color-white);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--duration-fast) var(--ease-out);
    margin-left: var(--space-2);
  }

  .header__nav-cta:hover {
    background: var(--color-red-600);
    transform: translateY(-1px);
    box-shadow: var(--shadow-red);
  }

  /* Hambúrguer */
  .header__toggle {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 28px;
    height: 22px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
  }

  .header__toggle-bar {
    display: block;
    width: 100%;
    height: 3px;
    background: var(--color-brown-900);
    border-radius: 2px;
    transition: all var(--duration-normal) var(--ease-out);
  }

  /* Estado aberto */
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(1) {
    transform: translateY(9.5px) rotate(45deg);
  }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(3) {
    transform: translateY(-9.5px) rotate(-45deg);
  }

  /* Mobile menu aberto */
  @media (max-width: 880px) {
    .header__nav[data-menu][data-open="true"] {
      display: flex;
      flex-direction: column;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-sand-50);
      border-bottom: 1px solid var(--color-sand-200);
      padding: var(--space-6);
      box-shadow: var(--shadow-md);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: var(--space-1);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-link {
      display: block;
      padding: var(--space-3) var(--space-4);
      font-size: var(--text-md);
    }
    .header__nav[data-menu][data-open="true"] .header__nav-cta {
      margin-top: var(--space-4);
      margin-left: 0;
      justify-content: center;
      padding: var(--space-3) var(--space-6);
    }
    .header__inner {
      position: relative;
    }
  }

  @media (min-width: 881px) {
    .header__toggle {
      display: none;
    }
    .header__nav {
      display: flex;
      align-items: center;
      gap: var(--space-4);
    }
    .header__nav-list {
      gap: var(--space-1);
    }
  }

  @media (max-width: 480px) {
    .header__brand-role { display: none; }
    .header__brand-text strong { font-size: var(--text-base); }
  }
</style>

<script>
  const toggle = document.querySelector('[data-menu-toggle]') as HTMLButtonElement | null;
  const menu = document.querySelector('[data-menu]') as HTMLElement | null;

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      toggle.setAttribute('aria-label', open ? 'Abrir menu' : 'Fechar menu');
      if (!open) {
        menu.setAttribute('data-open', 'true');
      } else {
        menu.removeAttribute('data-open');
      }
    });

    // Fechar ao clicar em link (mobile)
    menu.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu de navegação');
        menu.removeAttribute('data-open');
      });
    });

    // Fechar com ESC
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && menu.hasAttribute('data-open')) {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu de navegação');
        menu.removeAttribute('data-open');
        toggle.focus();
      }
    });
  }
</script>
