---
/**
 * Botão reutilizável — versão campanha popular
 *
 * Mudanças da v2:
 * - 2 variantes (primary vermelho + secondary preto chapado)
 * - 2 tamanhos (md + lg)
 * - Sem lift no hover (muda cor ou vira sólido)
 * - Sem sombra colorida
 * - Sem cubic-bezier custom
 */

interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  type?: 'button' | 'submit';
  external?: boolean;
  ariaLabel?: string;
  disabled?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  type = 'button',
  external = false,
  ariaLabel,
  disabled = false,
  class: className = '',
} = Astro.props;

const target = external ? '_blank' : undefined;
const rel = external ? 'noopener noreferrer' : undefined;

const classes = ['btn', `btn--${variant}`, `btn--${size}`, className].filter(Boolean).join(' ');
---

{href ? (
  <a
    class={classes}
    href={href}
    target={target}
    rel={rel}
    aria-label={ariaLabel}
  >
    <slot />
  </a>
) : (
  <button
    class={classes}
    type={type}
    aria-label={ariaLabel}
    disabled={disabled}
  >
    <slot />
  </button>
)}

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    font-family: var(--font-impacto);
    font-weight: var(--weight-regular);
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: var(--tracking-pancada);
    border: var(--border-grossa) solid var(--carvao);
    cursor: pointer;
    white-space: nowrap;
    line-height: 1;
    transition: background-color var(--transition-rapida), color var(--transition-rapida);
  }

  .btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn--md {
    padding: var(--space-3) var(--space-5);
    font-size: var(--text-sm);
    min-height: 44px;
  }

  .btn--lg {
    padding: var(--space-4) var(--space-6);
    font-size: var(--text-md);
    min-height: 56px;
  }

  /* Primary — vermelho PT chapado */
  .btn--primary {
    background: var(--carmin);
    color: var(--papel);
    border-color: var(--carvao);
  }

  .btn--primary:hover:not(:disabled) {
    background: var(--carmin-escuro);
  }

  /* Secondary — preto chapado */
  .btn--secondary {
    background: var(--carvao);
    color: var(--papel);
    border-color: var(--carvao);
  }

  .btn--secondary:hover:not(:disabled) {
    background: var(--preto);
  }
</style>
