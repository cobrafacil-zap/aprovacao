---
/**
 * Botão flutuante de WhatsApp (sempre visível, mobile-first)
 * Aparece após scroll de 600px (não atrapalha o hero)
 * Respeita prefers-reduced-motion
 */

import { SITE } from '../site.config.js';
const message = encodeURIComponent('Olá Elisângela, vim pelo site e quero conversar.');
const href = `https://wa.me/${SITE.contacts.whatsapp}?text=${message}`;
---

<a
  class="wa-float"
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar com a campanha no WhatsApp"
  data-wa-float
>
  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
  </svg>
  <span class="wa-float__label">Fale comigo</span>
</a>

<style>
  .wa-float {
    position: fixed;
    right: var(--space-4);
    bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    z-index: var(--z-overlay);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    background: #25D366;
    color: var(--color-white);
    border-radius: var(--radius-full);
    box-shadow: 0 8px 24px -4px rgb(37 211 102 / 0.5);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    text-decoration: none;
    transform: translateY(0);
    opacity: 0;
    pointer-events: none;
    transition: all var(--duration-normal) var(--ease-out);
  }

  .wa-float[data-visible="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .wa-float:hover {
    background: #20BD5A;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -4px rgb(37 211 102 / 0.6);
  }

  /* Pulse para chamar atenção (opcional, leve) */
  .wa-float::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #25D366;
    opacity: 0.4;
    z-index: -1;
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(1.4); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-float::before { animation: none; }
  }

  /* Em telas muito pequenas, só mostra o ícone */
  @media (max-width: 480px) {
    .wa-float__label { display: none; }
    .wa-float { padding: var(--space-3); }
  }
</style>

<script>
  const btn = document.querySelector('[data-wa-float]') as HTMLElement | null;
  if (btn) {
    let visible = false;
    const onScroll = () => {
      const shouldShow = window.scrollY > 600;
      if (shouldShow !== visible) {
        visible = shouldShow;
        btn.setAttribute('data-visible', String(visible));
      }
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
