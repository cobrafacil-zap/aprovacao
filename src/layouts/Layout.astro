---
/**
 * Layout base — todas as páginas usam este layout
 *
 * Inclui:
 * - <head> com SEO, Open Graph, Schema.org JSON-LD
 * - Google Fonts (Fraunces + Inter) com display=swap
 * - Header
 * - Slot para conteúdo
 * - Footer
 * - Banner de Cookies (LGPD)
 * - Botão flutuante de WhatsApp
 */

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { SITE } from '../site.config.js';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  pageType?: 'website' | 'article' | 'profile';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  title = SITE.seo.title,
  description = SITE.seo.description,
  ogImage = SITE.seo.ogImage,
  pageType = 'website',
  publishedTime,
  modifiedTime,
  author,
  noindex = false,
  bodyClass = '',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const fullOgImage = new URL(ogImage, Astro.site).toString();

// Schema.org JSON-LD — informações da candidata
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: SITE.role,
  affiliation: {
    '@type': 'PoliticalParty',
    name: SITE.partyFull,
  },
  url: Astro.site?.toString(),
  sameAs: [
    SITE.contacts.instagram,
    SITE.contacts.facebook,
  ].filter(Boolean),
  knowsAbout: [
    'Serviço Social',
    'Direitos da criança e do adolescente',
    'APAE',
    'Políticas públicas para pessoas idosas',
    'Políticas para mulheres',
    'Agricultura familiar',
  ],
};

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'PoliticalOrganization',
  name: `Campanha ${SITE.name} ${SITE.year || 2026}`,
  url: Astro.site?.toString(),
  logo: fullOgImage,
  sameAs: [
    SITE.contacts.instagram,
  ].filter(Boolean),
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO básico -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={SITE.seo.keywords} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon (emoji temporário — substituir por .ico/.svg real depois) -->
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✊</text></svg>" />

    <!-- Open Graph -->
    <meta property="og:type" content={pageType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={fullOgImage} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={`Campanha ${SITE.name}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {author && <meta property="article:author" content={author} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content={SITE.seo.twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullOgImage} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Fontes: Fraunces + Inter (com preconnect para performance) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700;9..144,900&family=Inter:wght@400;500;600;700;800&display=swap"
    />

    <!--
      📌 Google Analytics 4 + Meta Pixel ficam aqui,
      mas só inicializam APÓS consentimento de cookies.
      Implementação concreta: src/scripts/analytics.ts (carregado dinamicamente)
    -->

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>

  <body class={bodyClass}>
    <a href="#main" class="skip-link">Pular para o conteúdo principal</a>

    <Header />

    <main id="main" role="main">
      <slot />
    </main>

    <Footer />

    <WhatsAppFloat />
    <CookieBanner />
  </body>
</html>
